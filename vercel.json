{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/ux-lens/browser",
  "functions": {
    "api/*.ts": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },

    {
      "source": "/(.*)",
      "destination":  "/index.html"
    }
  ]

}
